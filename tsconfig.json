{
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "./dist/",
        "noImplicitAny": false,
        "module": "ES2020",
        "target": "ES2020",
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "types": [
            "bootstrap",
            "form-serialize",
            "jest",
            "jquery",
            "jstree",
            "node",
            "react",
            "react-dom",
            "react-grid-layout",
            "typeahead.js"
        ],
        "paths": {
            "js/*": [
                "./src/frontend/js/*"
            ],
            "components/*": [
                "./src/frontend/components/*"
            ],
            "util/*": [
                "./src/frontend/js/lib/util/*"
            ],
            "component": [
                "./src/frontend/js/lib/component"
            ],
            "validation": [
                "./src/frontend/js/lib/validation"
            ],
            "logging": [
                "./src/frontend/js/lib/logging"
            ],
            "get-field-values": [
                "./src/frontend/js/lib/get-field-values"
            ],
            "set-field-values": [
                "./src/frontend/js/lib/set-field-values"
            ],
            "plotly/*": [
                "./src/frontend/js/lib/plotly/*"
            ],
            "guid": [
                "./src/frontend/js/lib/guid"
            ],
        }
    },
    "include": [
        "src/frontend/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/**/*.test.ts",
        "src/**/*.definitions.ts",
        "src/frontend/testing/**/*.ts"
    ]
}
