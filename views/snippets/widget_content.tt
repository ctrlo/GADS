<h4>[% title | html %]</h4>
[% widget = 1 %]
[% IF type == "table" %]
    [% PROCESS snippets/data_table_inner.tt %]
[% ELSIF type == "graph" %]
    [% PROCESS snippets/data_graph_inner.tt %]
[% ELSIF type == "timeline" %]
    [% PROCESS snippets/data_timeline_inner.tt %]
[% ELSIF type == "globe" %]
    [% PROCESS snippets/data_globe_inner.tt %]
[% ELSIF type == "notice" %]
    [% content %]
[% ELSIF type == "field" %]
    [% PROCESS snippets/datum.tt %]
    [%# First column is ID, shift it into a void %]
    [% void = record.columns.shift %]
    <div class="list--key-value">
        <ul class="list__items">
            [% FOREACH datum IN record.columns %]
                <li class="list__item">
                    [% IF show_field_labels %]
                        <span class="list__key">
                            [% datum.name | html %]
                        </span>
                    [% END %]
                    <span class="list__value">
                        [% render_datum(datum, 'full') %]
                    </span>
                </li>
            [% END %]
        </ul>
    </div>
[% END %]
