[%
  # add standardized page header
  INCLUDE layouts/page_header.tt title = "Chronology of edits for record " _ record_id;
%]

<div class="content-block__main">
  <div class="content-block__main-content">
    <div class="chronology"></div>
    <div class="chronology_spinner my-3">
        <div class="spinner-border text-primary"></div>
        <div class="font-weight-bolder ms-2 mb-0 text-secondary">Loading...</div>
    </div>
    <button class="btn btn-primary btn-js-load-chronology" data-record-id="[% record_id %]">Load More</button>
  </div>
</div>
