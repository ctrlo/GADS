[%
  view_limit_groups = [{ items = [{
    label  = "Reset to normal",
    target = url.page _ "/" _ layout_obj.identifier _ "/data?view_limit_override=",
    alert  = 0
  }] }];

  FOR view_limit IN views_limit_override;
    view_limit_groups.0.items.push({
      label  = view_limit.name,
      target = url.page _ "/" _ layout_obj.identifier _ "/data?view_limit_override=" _ view_limit.id,
      alert  = 0
    });
  END;

  INCLUDE snippets/dropdown.tt
    id             = "view_limits_override"
    custom_classes = ""
    menu_right     = 1
    label          = "Override view limit"
    filter         = "html"
    groups         = view_limit_groups;
%]
